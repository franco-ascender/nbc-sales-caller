# NBC Voice AI
# Copy to .env.local and fill locally. Never paste private keys into the browser.
# The demo works without credentials.

# Supabase project: URL and public publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Private server key; use a secret key or legacy service-role key.
SUPABASE_SECRET_KEY=
# Email of a confirmed user in this project: Authentication > Users.
# This user signs in to the test dashboard with their own password.
NBC_OPERATOR_EMAIL=

# GoHighLevel sub-account private integration (not an agency-wide legacy API key).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=v3
# Optional: used in a later booking integration.
GHL_CALENDAR_ID=

# Generate independently, e.g. openssl rand -hex 32. Configure as the workflow's Bearer token.
GHL_WEBHOOK_SECRET=

# Local cloud administration only. Never deploy these management tokens.
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=
SUPABASE_ORGANIZATION_ID=
SUPABASE_PROJECT_REF=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# OpenAI and Anthropic keys are reserved; ElevenLabs powers the browser voice test.
# Claude uses ANTHROPIC_API_KEY. Keep these keys server-side only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Private internal voice-test agent. Provisioned separately; not a voice clone.
ELEVENLABS_AGENT_ID=
# Dedicated browser agent. Keep the telephone pilot agent in ELEVENLABS_AGENT_ID.
ELEVENLABS_WEB_AGENT_ID=

# Caller telephone pilot. Keep these server-only; telephone calls remain disabled
# until the caller phone policy, DNC checks and pilot approval are configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NBC_NUMBER_APPROVER_EMAIL=anas@nbcsales.io
TWILIO_PHONE_NUMBER=
ELEVENLABS_WEBHOOK_SECRET=
CALLER_PUBLIC_BASE_URL=

# Optional NBC Credits checkout (server-only; packages remain inactive until approved)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NBC_BILLING_ORIGIN=

# Master Tracker connectors (server-only; each is independent, missing = "no dato" not zero)
# Meta Marketing API: single ad account for now (mirrors the GHL single-location pattern).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Client revenue Stripe account. Deliberately separate from STRIPE_SECRET_KEY above,
# which is NBC's own billing account for Credits checkout, not a client's revenue.
TRACKER_STRIPE_SECRET_KEY=

# Lead Engine providers (server-only; discovery/verification stay disabled without these)
# Outscraper: primary business discovery (Google Maps). https://api.outscraper.cloud, header X-API-KEY.
OUTSCRAPER_API_KEY=
# Apify: second discovery provider, adapter ready. Requires Actor/build agreed separately.
APIFY_API_TOKEN=
# BatchData: phone verification. https://api.batchdata.com, Bearer token.
BATCHDATA_API_KEY=

# Lead Engine nightly register ingest (Vercel Cron sends this as Bearer). Generate with openssl rand -hex 32.
CRON_SECRET=
# Optional: which admin owns the cron runs (defaults to the first active admin in nbc_members).
LEAD_ENGINE_CRON_OPERATOR_ID=
