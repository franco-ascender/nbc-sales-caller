{
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(node scripts/vercel-project.mjs --check)",
      "Bash(node scripts/vercel-project.mjs --check *)",
      "Bash(node scripts/vercel-project.mjs --deploy)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run dev *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx playwright test *)",
      "Bash(node --experimental-strip-types --test *)",
      "Bash(node --test *)"
    ]
  }
}
